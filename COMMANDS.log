=== 2026-11-10T23:50:59Z /mnt/c/tmp/opus55/cleanroom-rows/run/11-all.sh
    #!/bin/bash
    # Final sequence with the final binary: main runs, second readings, label test, controls, small cutoffs, full checks.
    . /mnt/c/tmp/opus55/cleanroom-rows/run/lib.sh
    cp /mnt/c/tmp/opus55/cleanroom-rows/work/verify.py /mnt/c/tmp/opus55/cleanroom-rows/work/label.py .
    ulimit -v 2000000
    B=./target/release/cleanrows
    P=PREDICT-STAGE-A.hbp
    rm -rf out; mkdir -p out/main out/small out/controls out/full
    : > out/progress.txt
    for m in 11 12 13; do
      /usr/bin/time -v $B run $m out/main $P --rep sample > out/main/stdout-m$m.txt 2> out/main/time-m$m.txt
      echo "main m0=$m exit=$?" >> out/progress.txt
    done
    for m in 11 12 13; do
      /usr/bin/time -v python3 verify.py out/main/rows-m$m.hbp > out/main/verify-m$m.hbp 2> out/main/verify-time-m$m.txt
      echo "verify m0=$m exit=$? sha256sum=$(sha256sum out/main/rows-m$m.hbp | cut -d' ' -f1)" >> out/progress.txt
    done
    # label cross-check: Python moves class representatives by a symmetry and a gauge transformation, Rust labels them
    python3 label.py --variants out/main/rows-m13.hbp 300 > out/main/label-variants.txt
    ok=0; bad=0; n=0
    while read cfg key m; do
      n=$((n+1))
      if [ $n -le 20 ]; then line=$($B label $cfg out/main/rows-m13.hbp); else line=$($B label $cfg); fi
      pl=$(python3 label.py $cfg)
      rk=$(echo "$line" | sed 's/.*class_key=\([0-9]*\).*/\1/'); rm_=$(echo "$line" | sed 's/.*|M=\([0-9]*\).*/\1/')
      pk=$(echo "$pl" | sed 's/.*class_key=\([0-9]*\).*/\1/')
      if [ "$rk" = "$key" ] && [ "$rm_" = "$m" ] && [ "$pk" = "$key" ]; then ok=$((ok+1)); else bad=$((bad+1)); fi
      [ $n -le 3 ] && echo "$line" >> out/main/label-examples.txt
    done < out/main/label-variants.txt
    echo "LABELTEST|configs=$n|rust_python_agree=$ok|disagree=$bad|json=0" > out/main/labeltest.hbp
    echo "labeltest done" >> out/progress.txt
    # controls at m0 = 7, every check on every class
    : > out/controls/CONTROLS.hbp
    /usr/bin/time -v $B run 7 out/controls $P --rep all --orbit-balance --tag -base > out/controls/stdout-base.txt 2> out/controls/time-base.txt
    base=$(grep '^ROWS' out/controls/stdout-base.txt | sed 's/.*sha256=\([0-9a-f]*\).*/\1/')
    basefp=$(grep '^FINGERPRINT' out/controls/stdout-base.txt | sed 's/.*sha256=\([0-9a-f]*\).*/\1/')
    for mu in 1 2 3 9 4 5 6 7 8; do
      /usr/bin/time -v $B run 7 out/controls $P --rep all --orbit-balance --mut $mu --tag -mut$mu > out/controls/stdout-mut$mu.txt 2> out/controls/time-mut$mu.txt
      ex=$?
      fails=$(grep '^CHECK' out/controls/stdout-mut$mu.txt | grep 'result=FAIL' | sed 's/CHECK|name=\([^|]*\)|.*/\1/' | tr '\n' ',' | sed 's/,$//')
      sha=$(grep '^ROWS' out/controls/stdout-mut$mu.txt | sed 's/.*sha256=\([0-9a-f]*\).*/\1/')
      fp=$(grep '^FINGERPRINT' out/controls/stdout-mut$mu.txt | sed -n 's/.*sha256=\([0-9a-f]*\).*/\1/p')
      same=NO; [ "$sha" = "$base" ] && same=YES
      samefp=NO; [ "$fp" = "$basefp" ] && samefp=YES
      rss=$(grep 'Maximum resident' out/controls/time-mut$mu.txt | awk '{print $NF}')
      echo "CONTROL|m0=7|mutation=$mu|exit=$ex|failed_checks=${fails:-none}|rows_sha_equals_unmutated=$same|fingerprint_equals_unmutated=$samefp|maxrss_kib=$rss|json=0" >> out/controls/CONTROLS.hbp
    done
    for mu in 4 5 6; do
      /usr/bin/time -v $B run 11 out/controls $P --rep none --mut $mu --tag -mut$mu > out/controls/stdout-m11-mut$mu.txt 2> out/controls/time-m11-mut$mu.txt
      ex=$?
      fails=$(grep '^CHECK' out/controls/stdout-m11-mut$mu.txt | grep 'result=FAIL' | sed 's/CHECK|name=\([^|]*\)|.*/\1/' | tr '\n' ',' | sed 's/,$//')
      rss=$(grep 'Maximum resident' out/controls/time-m11-mut$mu.txt | awk '{print $NF}')
      echo "CONTROL|m0=11|mutation=$mu|exit=$ex|failed_checks=${fails:-none}|rep_mode=none|maxrss_kib=$rss|json=0" >> out/controls/CONTROLS.hbp
    done
    rm -f out/controls/rows-m*.hbp
    echo "controls done" >> out/progress.txt
    for m in 3 4 6 7 8 9 10; do
      /usr/bin/time -v $B run $m out/small $P --rep all --orbit-balance > out/small/stdout-m$m.txt 2> out/small/time-m$m.txt
      echo "small m0=$m exit=$?" >> out/progress.txt
    done
    /usr/bin/time -v $B run 11 out/full $P --rep all --orbit-balance > out/full/stdout-m11.txt 2> out/full/time-m11.txt
    echo "full m0=11 exit=$? sha=$(sha256sum out/full/rows-m11.hbp | cut -d' ' -f1)" >> out/progress.txt
    rm -f out/full/rows-m11.hbp
    echo ALLDONE >> out/progress.txt

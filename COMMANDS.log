=== 2026-11-11T00:21:38Z /mnt/c/tmp/opus55/cleanroom-rows/run/12-finalize.sh
    #!/bin/bash
    # Assemble results, scan the sources, make the second commit. Nothing is run after this script.
    . /mnt/c/tmp/opus55/cleanroom-rows/run/lib.sh
    W=/mnt/c/tmp/opus55/cleanroom-rows/work
    grep -q '^ALLDONE' out/progress.txt || { echo "runs not finished"; exit 1; }
    cp $W/FORMAT.md $W/CHOICES.md $W/EXPOSURE.md .
    grep -qx 'out/' .gitignore || echo 'out/' >> .gitignore
    cp $W/Cargo.toml . ; cp $W/src/*.rs src/
    cmp $W/verify.py verify.py && cmp $W/label.py label.py && cmp $W/predict.py predict.py || { echo "staged python differs"; exit 1; }
    # the binary that produced the results must come from the committed source
    cargo +1.81 clippy --release -- -D warnings > /tmp/cleanrows-clippy.txt 2>&1; clippy=$?
    cargo +1.81 build --release 2>&1 | grep -c Compiling > /tmp/cleanrows-rebuild.txt; rebuilt=$(cat /tmp/cleanrows-rebuild.txt)
    rm -rf results; mkdir -p results/main results/small results/controls results/full
    for d in main small controls full; do
      for f in out/$d/*; do
        case "$f" in
          *rows-m*.hbp) gzip -n -6 -c "$f" > results/$d/$(basename "$f").gz ;;
          *) cp "$f" results/$d/ ;;
        esac
      done
    done
    cp out/progress.txt results/progress.txt
    R=RESULTS.hbp
    : > $R
    echo "RESULTS-HEAD|stage=A|lattice=3x4|group=S3|cutoffs=11,12,13|coupling_used=0|float_used=0|json=0" >> $R
    for m in 11 12 13; do
      grep -vE '^SUMMARY-HEAD' out/main/stdout-m$m.txt | sed "s/^PERM|/PERM|m0=$m|/; s/^HIST|/HIST|m0=$m|/; s/^FLAT|/FLAT|m0=$m|/; s/^ENUM|/ENUM|m0=$m|/; s/^CHECK|/CHECK|m0=$m|/; s/^ROWS|/ROWS|m0=$m|/" >> $R
      sed "s/^V\([A-Z]*\)|/VERIFY-\1|/" out/main/verify-m$m.hbp | sed "s/^VERIFY-\(PERM\|HIST\|BALANCE\|ROWS\|RUN\)|/VERIFY-\1|m0=$m|/" >> $R
      rs=$(grep '^ROWS' out/main/stdout-m$m.txt | sed 's/.*sha256=\([0-9a-f]*\).*/\1/')
      vs=$(grep '^VROWS' out/main/verify-m$m.hbp | sed 's/.*sha256=\([0-9a-f]*\).*/\1/')
      ss=$(sha256sum out/main/rows-m$m.hbp | cut -d' ' -f1)
      gs=$(gzip -dc results/main/rows-m$m.hbp.gz | sha256sum | cut -d' ' -f1)
      rf=$(grep '^FINGERPRINT' out/main/stdout-m$m.txt | sed 's/^FINGERPRINT|//')
      vf=$(grep '^VFINGERPRINT' out/main/verify-m$m.hbp | sed 's/^VFINGERPRINT|//')
      rt=$(grep '^TOTALS' out/main/stdout-m$m.txt | sed 's/^TOTALS|//')
      vt=$(grep '^VTOTALS' out/main/verify-m$m.hbp | sed 's/^VTOTALS|//')
      e1=NO; [ "$rs" = "$vs" ] && [ "$rs" = "$ss" ] && [ "$rs" = "$gs" ] && e1=YES
      e2=NO; [ "$rf" = "$vf" ] && e2=YES
      e3=NO; [ "$rt" = "$vt" ] && e3=YES
      echo "CROSS|m0=$m|rows_sha_rust_python_sha256sum_gzip_equal=$e1|fingerprint_rust_python_equal=$e2|totals_rust_python_equal=$e3|json=0" >> $R
    done
    for f in out/main/time-m*.txt out/main/verify-time-m*.txt out/small/time-m*.txt out/full/time-m*.txt out/controls/time-*.txt; do
      rss=$(grep 'Maximum resident' $f | awk '{print $NF}')
      wall=$(grep 'Elapsed' $f | awk '{print $NF}')
      ex=$(grep 'Exit status' $f | awk '{print $NF}')
      under=YES; [ "$rss" -lt 2097152 ] || under=NO
      echo "MEM|run=$(echo $f | sed 's|out/||; s|/time-|:|; s|/verify-time-|:verify-|; s|\.txt||')|maxrss_kib=$rss|below_2097152=$under|wall=$(echo $wall | tr ':' 'm')|exit=$ex|json=0" >> $R
    done
    for m in 3 4 6 7 8 9 10; do
      grep -E '^(TOTALS|FINGERPRINT|CHECK|RUN)' out/small/stdout-m$m.txt | sed "s/^CHECK|/SMALL-CHECK|m0=$m|/; s/^TOTALS|/SMALL-TOTALS|/; s/^FINGERPRINT|/SMALL-FINGERPRINT|/; s/^RUN|/SMALL-RUN|/" >> $R
    done
    grep -E '^(CHECK|RUN|FINGERPRINT|ROWS)' out/full/stdout-m11.txt | sed "s/^CHECK|/FULL11-CHECK|/; s/^RUN|/FULL11-RUN|/; s/^FINGERPRINT|/FULL11-FINGERPRINT|/; s/^ROWS|/FULL11-ROWS|/" >> $R
    cat out/controls/CONTROLS.hbp >> $R
    cat out/main/labeltest.hbp >> $R
    # source scans
    fl=$(grep -nE '\b(f32|f64)\b|[0-9]\.[0-9]|float|as f' src/*.rs predict.py verify.py label.py | grep -vc 'FIPS 180-4')
    dv=$(grep -nE '[^/<]/[^/>]' predict.py verify.py label.py | grep -vcE '^[^:]*:[0-9]+:\s*#|usr/bin')
    us=$(grep -c 'unsafe' src/*.rs | awk -F: '{s+=$2} END {print s}')
    cr=$(grep -lU $'\r' *.md *.hbp *.py *.toml src/*.rs COMMANDS.log results/*/*.txt results/*/*.hbp 2>/dev/null | wc -l)
    badrow=$(cat *.hbp results/*/*.hbp | grep -vcE '^[A-Z0-9-]+(\|[A-Za-z0-9_]+=[^|]*)+\|json=0$')
    echo "SCAN|float_tokens_in_source=$fl|python_true_division=$dv|unsafe_in_rust=$us|files_with_cr=$cr|hbp_rows_not_matching_grammar=$badrow|clippy_exit=$clippy|crates_recompiled_at_finalize=$rebuilt|json=0" >> $R
    grep -nE '\b(f32|f64)\b|[0-9]\.[0-9]|float|as f' src/*.rs predict.py verify.py label.py > results/scan-float-matches.txt
    echo "NOTE|rows_files=results/main/rows-mNN.hbp.gz|compression=gzip_-n_-6|sha256_is_of_uncompressed_bytes=1|json=0" >> $R
    tail -30 $R | cut -c1-260
    git add -A .
    git -c user.name="Jesse Daniel Brown" -c user.email="plasmatoid@gmail.com" commit -q -m "Stage A results: enumeration, rows, fingerprints, checks and controls for m0 = 11, 12, 13"
    git log --format='%H %an <%ae> %s%n[body:%b]'
    git status --short | head; git remote -v | wc -l; du -sh .git results
    git ls-files | head -80
